HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Requires a verified SES identity and AWS credentials with ses:SendEmail.
# Leave unset to explicitly disable code delivery; codes are never logged.
AWS_REGION=us-east-1
AUTH_EMAIL_FROM=Guess Who's Santa <signin@guesswhossanta.com>
MAX_UPLOAD_BYTES=10485760
# Local Postgres: docker compose up -d db
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=santa
DATABASE_PASSWORD=santa-local-only
DATABASE_NAME=santa
# Local photo storage (production uses S3 + signed CloudFront URLs)
LOCAL_MEDIA_DIR=./media
LOCAL_MEDIA_SECRET=change-me-local-only
PHOTO_RETENTION_DAYS=30
# Legacy unmasked upload testing only; never enable on a public server.
UPLOAD_DIR=./uploads
ENABLE_LOCAL_UPLOADS=false
